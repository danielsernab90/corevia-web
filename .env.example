# Public site URL used for metadata, Open Graph, and canonical links.
# Production example: https://corevia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calendly scheduling URL embedded in the consultation booking modal.
# Must match a live Calendly event URL (currently 10–15 min consultation).
# Production (Vercel) must use the same value — NEXT_PUBLIC_* is baked at build time.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/danielserna_techsolutions/10-15min

# Shared NestJS API (Leads + future modules). Used only by server routes
# such as /api/inquiry — never expose this to the browser.
# Example local: http://localhost:4000
COREVIA_API_URL=http://localhost:4000

# Command Station SQLite (optional override). Default:
# ~/Library/Application Support/cesar-property-management/data.db
COMMAND_STATION_DB_PATH=

# Optional email safety net for new inquiries (Resend).
# Without RESEND_API_KEY, inquiries still save to SQLite; email is skipped.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=danielsernab90@gmail.com
# Verified sender in Resend — until then Resend's onboarding address works for tests:
INQUIRY_FROM_EMAIL=Corevia Inquiries <onboarding@resend.dev>
